{
  "name": "@cesar4280/exact-math",
  "version": "0.1.0",
  "description": "Exact rational arithmetic library (BigInt-backed) for business logic that cannot tolerate floating-point error.",
  "type": "module",
  "main": "src/math/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/math/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "example:frequency-table": "node examples/frequency-table.js",
    "example:weather-stats": "node examples/weather-stats.js",
    "example:weather-stats-live": "node examples/weather-stats-live.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:types": "tsc",
    "prepack": "pnpm build:types",
    "prepublishOnly": "pnpm test && pnpm format:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rational",
    "fraction",
    "bigint",
    "exact-arithmetic",
    "arbitrary-precision",
    "decimal",
    "math"
  ],
  "author": {
    "name": "Cesar J. Fajardo Ortiz",
    "url": "https://github.com/Cesar4280"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cesar4280/exact-math.git"
  },
  "homepage": "https://github.com/Cesar4280/exact-math#readme",
  "bugs": {
    "url": "https://github.com/Cesar4280/exact-math/issues"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
